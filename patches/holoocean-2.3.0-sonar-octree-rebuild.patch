+
+int Octree::invalidateCache(const FBox* region) {
+	FString		  folder = cacheFolder();
+	IFileManager& fm = IFileManager::Get();
+	if (!fm.DirectoryExists(*folder)) {
+		return 0;
+	}
+	if (region == nullptr) {
+		TArray<FString> files;
+		fm.FindFiles(files, *(folder / TEXT("*.json")), true, false);
+		fm.DeleteDirectory(*folder, false, true);
+		UE_LOG(LogHolodeck, Log, TEXT("Octree::invalidateCache deleted %s"), *folder);
+		return files.Num();
+	}
+
+	// roots.json lists the occupied OctreeMax cells of the whole level: always rebuilt.
+	int n = fm.Delete(*(folder / TEXT("roots.json")), false, true, true) ? 1 : 0;
+	// Cell files are named after the cell centre (see makeEnvOctreeRoot): walk the same
+	// subdivision from the root down to OctreeMax and delete the cells touching the region.
+	std::function<void(FVector, float)> walk = [&](FVector c, float size) {
+		FBox cell(c - FVector(size / 2), c + FVector(size / 2));
+		if (!cell.Intersect(*region)) {
+			return;
+		}
+		if (size <= OctreeMax) {
+			FString f = folder + "/" + FString::FromInt((int)c.X) + "_"
+				+ FString::FromInt((int)c.Y) + "_" + FString::FromInt((int)c.Z) + ".json";
+			n += fm.Delete(*f, false, true, true) ? 1 : 0;
+			return;
+		}
+		for (FVector off : corners) {
+			walk(c + (off * size / 4), size / 2);
+		}
+	};
+	walk(EnvCenter, OctreeRoot);
+	UE_LOG(LogHolodeck, Log, TEXT("Octree::invalidateCache deleted %d files in %s"), n, *folder);
+	return n;
+}
