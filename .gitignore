# development runs and probes output
results/dev/
results/v2/dev/
results/v2/demos/*/drone_*_state.jsonl
probe/out/
formal/results_*.log

# bulky per-run artifacts of the demonstrative runs stay on disk (regenerated by the scripts);
# metrics, summaries, events, run configs, per-drone states and referee time series are versioned,
# key figures and GIFs are versioned as copies in figures/
results/**/frames/
results/**/dashboard/
results/**/dashboard_replay/
results/**/sensors/
results/**/figures/
results/**/*.gif
results/**/drone_*_observations.jsonl
results/**/drone_*_actions.jsonl
results/logs/

# user's own presentation material (not part of the code base)
ppt/
