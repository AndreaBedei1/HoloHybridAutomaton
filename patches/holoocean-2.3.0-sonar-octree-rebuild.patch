+#pragma once
+
+#include "Holodeck.h"
+#include "Command.h"
+
+#include "RebuildSonarOctreeCommand.generated.h"
+
+/**
+ * RebuildSonarOctreeCommand
+ * Tells every sonar in the world that the static scene changed: the on-disk octree cache of
+ * the current level and octree size is invalidated (whole folder, or only the cells touching
+ * a region) and every sonar rebuilds its octrees from the current scene.  Without it, props
+ * spawned after the first sonar initialised are invisible, and a cache written in another
+ * scene produces ghost echoes.
+ *
+ * NumberParameters: empty (invalidate the whole level cache), or six values
+ * [x_min, y_min, z_min, x_max, y_max, z_max] in client coordinates (metres) delimiting the
+ * region whose cells must be recomputed.
+ */
+UCLASS()
+class HOLODECK_API URebuildSonarOctreeCommand : public UCommand {
+	GENERATED_BODY()
+
+public:
+	// See UCommand for the documentation of this overridden function.
+	void Execute() override;
+};
