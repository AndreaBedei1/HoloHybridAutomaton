+    def rebuild_sonar_octree(self, region=None):
+        """Tell the sonars that the static scene changed and rebuild their octrees.
+
+        HoloOcean sonars see the static scene through an octree that is built when the first
+        sonar initialises and cached on disk per level and octree size.  Props spawned after
+        that (or removed by a reset) are therefore missing from, or still present in, the
+        octree.  This invalidates the cached cells (all of them, or only those touching
+        ``region``) and makes every sonar rebuild its octrees from the current scene, without
+        restarting the engine.  Caches of other levels and octree sizes are not touched.
+
+        Sonar outputs are not meaningful until each sonar has re-initialised and captured
+        again; the returned number of ticks is an upper bound for that.
+
+        Args:
+            region (:obj:`tuple` of two ``[x, y, z]``, optional): axis-aligned box (metres)
+                around the geometry that changed.  ``None`` invalidates the whole level cache.
+
+        Returns:
+            :obj:`int`: ticks after which every sonar has produced data from the new octree.
+        """
+        self._has_sonar = True  # octree construction may exceed the handshake timeout
+        self._enqueue_command(RebuildSonarOctreeCommand(region))
+        ticks_per_capture = [
+            getattr(sensor, "tick_every", None) or 1
+            for agent in self.agents.values()
+            for sensor in agent.sensors.values()
+            if sensor.sensor_type in SensorDefinition._sonar_sensors
+        ]
+        return 8 + 2 * max(ticks_per_capture, default=1) + 1
+
