@@ -0,0 +1,52 @@
+// MIT License (c) 2019 BYU PCCL see LICENSE file
+
+#include "RebuildSonarOctreeCommand.h"
+#include "Holodeck.h"
+#include "HolodeckGameMode.h"
+#include "HolodeckSonar.h"
+#include "Octree.h"
+#include "UObject/UObjectIterator.h"
+
+void URebuildSonarOctreeCommand::Execute() {
+	UE_LOG(LogHolodeck, Log, TEXT("URebuildSonarOctreeCommand::Execute"));
+
+	if (NumberParams.size() != 0 && NumberParams.size() != 6) {
+		UE_LOG(
+			LogHolodeck,
+			Error,
+			TEXT("RebuildSonarOctree expects 0 or 6 number parameters. Command not executed."));
+		return;
+	}
+	UWorld* World = Target ? Target->GetWorld() : nullptr;
+	if (World == nullptr) {
+		UE_LOG(
+			LogHolodeck, Warning, TEXT("RebuildSonarOctree: world is nullptr. Command not executed."));
+		return;
+	}
+
+	int deleted = 0;
+	if (NumberParams.size() == 6) {
+		FVector a = ConvertLinearVector(
+			FVector(NumberParams[0], NumberParams[1], NumberParams[2]), ClientToUE);
+		FVector b = ConvertLinearVector(
+			FVector(NumberParams[3], NumberParams[4], NumberParams[5]), ClientToUE);
+		FBox region(a.ComponentMin(b), a.ComponentMax(b));
+		deleted = Octree::invalidateCache(&region);
+	} else {
+		deleted = Octree::invalidateCache(nullptr);
+	}
+
+	int sonars = 0;
+	for (TObjectIterator<UHolodeckSonar> It; It; ++It) {
+		if (It->GetWorld() == World && It->IsRegistered()) {
+			It->ResetOctree();
+			++sonars;
+		}
+	}
+	UE_LOG(
+		LogHolodeck,
+		Log,
+		TEXT("RebuildSonarOctree: %d cache files invalidated, %d sonars reset"),
+		deleted,
+		sonars);
+}
